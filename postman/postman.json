          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_candidat}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Développeur Full Stack\",\n  \"bio\": \"Passionné par le développement web et les nouvelles technologies.\",\n  \"localisation\": \"Casablanca\",\n  \"disponible\": true\n}",
              "options": { "raw": { "language": "json" } }
