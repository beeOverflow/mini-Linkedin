    {
      "name": "3. Offres d'emploi",
      "item": [
        {
          "name": "Lister les offres actives",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Réponse paginée', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('data');",
                  "  pm.expect(json).to.have.property('current_page');",
                  "});",
                  "pm.test('Stocker ID première offre', () => {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.length > 0) {",
                  "    pm.collectionVariables.set('offre_id', json.data[0].id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_candidat}}" }
            ],
            "url": {
              "raw": "{{base_url}}/offres?page=1",
              "host": ["{{base_url}}"],
              "path": ["offres"],
              "query": [{ "key": "page", "value": "1" }]
            }
          }
        },
        {
          "name": "Lister offres — Filtrer par localisation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_candidat}}" }
            ],
            "url": {
              "raw": "{{base_url}}/offres?localisation=Casablanca",
              "host": ["{{base_url}}"],
              "path": ["offres"],
              "query": [{ "key": "localisation", "value": "Casablanca" }]
            }
          }
        },
        {
          "name": "Lister offres — Filtrer par type",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Toutes les offres sont de type CDI', () => {",
                  "  const json = pm.response.json();",
                  "  json.data.forEach(offre => pm.expect(offre.type).to.eql('CDI'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_candidat}}" }
            ],
            "url": {
              "raw": "{{base_url}}/offres?type=CDI",
              "host": ["{{base_url}}"],
              "path": ["offres"],
              "query": [{ "key": "type", "value": "CDI" }]
            }
          }
        },
        {
          "name": "Détail d'une offre",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Offre contient les bonnes clés', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.include.keys(['id', 'titre', 'description', 'localisation', 'type']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_candidat}}" }
            ],
            "url": { "raw": "{{base_url}}/offres/{{offre_id}}", "host": ["{{base_url}}"], "path": ["offres", "{{offre_id}}"] }
          }
        },
        {
          "name": "Créer une offre (recruteur)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Offre créée avec titre', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('titre');",
                  "  pm.collectionVariables.set('offre_id', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_recruteur}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Développeur Laravel Senior\",\n  \"description\": \"Nous recherchons un développeur Laravel expérimenté pour rejoindre notre équipe.\",\n  \"localisation\": \"Casablanca\",\n  \"type\": \"CDI\",\n  \"actif\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/offres", "host": ["{{base_url}}"], "path": ["offres"] }
          }
        },
        {
          "name": "Modifier une offre (recruteur propriétaire)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Titre mis à jour', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.titre).to.eql('Développeur Laravel Expert');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_recruteur}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Développeur Laravel Expert\",\n  \"description\": \"Description mise à jour.\",\n  \"localisation\": \"Rabat\",\n  \"type\": \"CDI\",\n  \"actif\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/offres/{{offre_id}}", "host": ["{{base_url}}"], "path": ["offres", "{{offre_id}}"] }
          }
        },
        {
          "name": "Supprimer une offre (recruteur propriétaire)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 ou 204', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_recruteur}}" }
            ],
            "url": { "raw": "{{base_url}}/offres/{{offre_id}}", "host": ["{{base_url}}"], "path": ["offres", "{{offre_id}}"] }
          }
        },
        {
          "name": "[ERREUR 403] Créer offre — En tant que candidat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_candidat}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Offre non autorisée\",\n  \"description\": \"Test\",\n  \"localisation\": \"Casablanca\",\n  \"type\": \"CDI\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/offres", "host": ["{{base_url}}"], "path": ["offres"] }
          }
        },
        {
          "name": "[ERREUR 403] Modifier offre d'un autre recruteur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_recruteur}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Tentative de modification\"\n}",
