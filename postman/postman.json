                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.include.keys(['titre', 'bio', 'localisation', 'disponible']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_candidat}}" }
            ],
            "url": { "raw": "{{base_url}}/profil", "host": ["{{base_url}}"], "path": ["profil"] }
          }
        },
        {
          "name": "Modifier son profil",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Localisation mise à jour', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.localisation).to.eql('Rabat');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_candidat}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Développeur Full Stack Senior\",\n  \"bio\": \"Expérience de 5 ans en développement web.\",\n  \"localisation\": \"Rabat\",\n  \"disponible\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/profil", "host": ["{{base_url}}"], "path": ["profil"] }
          }
        },
